# Copy this file to .env and fill it in. Never commit .env or anything in secrets/.

ADMIN_PASSWORD=pick-a-strong-password
PORT=3000
# Public address once deployed (used for the Google sign-in redirect), e.g. https://maxing.fofmumbai.com
# PUBLIC_URL=

# Where the database lives (and media, until it moves to Google Drive). Use a persistent disk.
DATA_DIR=./data

TEAM_COUNT=25
MAX_MEMBERS=4
MAX_FILE_MB=300

# ---- Google Drive (optional; see DRIVE_SETUP.md) ----
# Option A: personal Google account. OAuth client JSON from Cloud Console...
GOOGLE_OAUTH_CLIENT_FILE=./secrets/google-oauth-client.json
# ...or the two values from it (handy on hosts):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# DRIVE_FOLDER_NAME=Mumbai Maxing 2026

# Option B: Workspace Shared Drive with a service account
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# DRIVE_FOLDER_ID=

# Keep a local copy of every file as well as the Drive copy (needs more disk):
# DRIVE_KEEP_LOCAL=1
